{
  "expo": {
    "name": "Go Digital Marketing CRM",
    "slug": "go-digital-marketing-crm",
    "scheme": "godigitalcrm",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#f5f6f8",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Go Digital Marketing CRM to scan a one-time mobile link QR code."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Go Digital Marketing CRM to record an active test-drive route.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      ["expo-media-library", { "granularPermissions": ["audio"] }]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.godigitalmarketing.crm"
    },
    "android": {
      "package": "com.godigitalmarketing.crm",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
