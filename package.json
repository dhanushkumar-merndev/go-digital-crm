{
  "name": "go-digital-marketing-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "pnpm env:check:web && next build --webpack",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:mobile": "pnpm --dir mobile typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:api": "vitest run tests/api",
    "check:edge": "pnpm dlx deno@2.9.5 check supabase/functions/_shared/*.ts supabase/functions/*/index.ts",
    "check:supabase-config": "node scripts/check-supabase-config.mjs",
    "env:check": "node scripts/validate-env.mjs",
    "env:check:example": "node scripts/validate-env.mjs --target example",
    "env:check:web": "node scripts/validate-env.mjs --target web --mode production",
    "env:check:mobile": "node scripts/validate-env.mjs --target mobile --mode production",
    "env:check:edge": "node scripts/validate-env.mjs --target edge --mode production",
    "env:check:trigger": "node scripts/validate-env.mjs --target trigger --mode production",
    "env:check:all": "node scripts/validate-env.mjs --target all --mode production",
    "env:check:deployment": "node scripts/validate-env.mjs --target deployment --mode production",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:mobile && pnpm mobile:doctor && pnpm test:api && pnpm check:supabase-config && pnpm check:edge && pnpm build:webpack",
    "supabase:local:start": "pnpm dlx supabase@2.114.0 start",
    "supabase:local:reset": "pnpm dlx supabase@2.114.0 db reset",
    "supabase:link": "pnpm dlx supabase@2.114.0 link",
    "supabase:db:push": "pnpm dlx supabase@2.114.0 db push",
    "supabase:functions:deploy": "pnpm dlx supabase@2.114.0 functions deploy",
    "trigger:deploy:dry-run": "pnpm dlx trigger.dev@4.5.11 deploy --dry-run --skip-update-check",
    "trigger:deploy:staging": "pnpm dlx trigger.dev@4.5.11 deploy --env staging --skip-update-check",
    "trigger:deploy:production:candidate": "pnpm dlx trigger.dev@4.5.11 deploy --env prod --skip-promotion --skip-update-check",
    "vercel:deploy:preview": "pnpm dlx vercel@59.1.3",
    "vercel:deploy:production": "pnpm dlx vercel@59.1.3 --prod",
    "mobile:doctor": "pnpm dlx expo-doctor@1.20.2 mobile",
    "mobile:build:preview": "node scripts/run-eas.mjs build --profile preview --platform all",
    "mobile:build:production": "node scripts/run-eas.mjs build --profile production --platform all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1110.0",
    "@aws-sdk/lib-storage": "3.1110.0",
    "@aws-sdk/s3-request-presigner": "3.1110.0",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-table": "^8.21.3",
    "@trigger.dev/sdk": "4.5.11",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "echarts": "latest",
    "idb-keyval": "latest",
    "lucide-react": "latest",
    "maplibre-gl": "^6.3.0",
    "next": "16.3.0",
    "qrcode": "latest",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/qrcode": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "latest",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "latest"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.21.0"
  },
  "packageManager": "pnpm@11.21.0"
}
