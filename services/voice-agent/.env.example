# PIOPIY Voice AI agent (dashboard.piopiy.com > Voice AI Agents).
AGENT_ID=
AGENT_TOKEN=
# Speech and language providers. Server-side only.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
# Optional model overrides.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile
# https://<project-ref>.supabase.co/functions/v1
CRM_EDGE_BASE_URL=
# Same value as the Supabase Edge secret AI_AGENT_SERVICE_SECRET (at least 32 characters).
AI_AGENT_SERVICE_SECRET=
AGENT_DEBUG=false
