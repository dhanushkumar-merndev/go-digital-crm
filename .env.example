# Public web configuration (values are embedded into the browser bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local visual QA only. This is honored only by `next dev` when set to the literal `true`.
# Production builds ignore it and fail closed when Supabase configuration is absent.
NEXT_PUBLIC_ENABLE_LOCAL_PREVIEW=false

# Public Expo configuration. Use the same project URL and publishable/anon key;
# never place a service-role or provider credential in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server/worker configuration. Never prefix these secrets with NEXT_PUBLIC_ or EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000
PUBLIC_EDGE_FUNCTION_BASE_URL=
INTEGRATION_OAUTH_CALLBACK_URL=

# 32 random bytes encoded as base64url. Keep old key versions during rotation.
INTEGRATION_ENCRYPTION_KEY=

# Platform Meta application configuration. Keep the current reviewed Graph version
# and approved scopes configurable so provider upgrades stay inside the adapter.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_OAUTH_SCOPES=ads_management,leads_retrieval,pages_show_list,pages_read_engagement,pages_manage_ads,pages_manage_metadata
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Platform Google OAuth/Ads application configuration. Tenant refresh tokens are
# stored encrypted per connection and do not belong in environment variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Server-only delivery/storage/background providers.
BREVO_API_KEY=
TIGRIS_ENDPOINT=
TIGRIS_REGION=auto
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Upstash Redis cache. Server/Edge only: never use a NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix.
# Create separate Upstash databases for development and production. Keep disabled until
# both REST values are configured as Supabase Edge Function secrets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_CACHE_PREFIX=go-digital
UPSTASH_REDIS_ENABLED=false

# Optional worker tuning; defaults are deliberately bounded for small deployments.
PROVIDER_EVENT_BATCH_SIZE=25
PROVIDER_EVENT_CONCURRENCY=5

# Comma-separated exact hosts or explicit wildcards (for example *.provider.com)
# accepted for server-side IVR recording downloads.
IVR_RECORDING_ALLOWED_HOSTS=
MAX_RECORDING_BYTES=104857600
